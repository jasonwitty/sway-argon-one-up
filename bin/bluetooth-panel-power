#!/bin/bash
# bluetooth-panel-power — turn Bluetooth on or off, remembered across reboots.
#
#   bluetooth-panel-power on|off|toggle|is-on
#
# Ported from Omarchy's omarchy-bluetooth-power (MIT, see
# network-panel/LICENSE-omarchy).
#
# BlueZ never persists an adapter's Powered property, so turning Bluetooth off
# through bluetoothctl lasts only until the next boot. The rfkill soft block
# does persist: systemd-rfkill saves every switch and restores it early on the
# next boot. So the block is the state and BlueZ follows it: unblocking leaves
# AutoEnable at its default and bluetoothd powers the adapter up by itself.

POWER_WAIT_SECONDS=${BLUETOOTH_PANEL_POWER_WAIT_SECONDS:-2}

# install.sh grants passwordless sudo for exactly these rfkill calls; fall back
# to a plain call for systems where /dev/rfkill is writable by the user.
set_block() {
  sudo -n /usr/sbin/rfkill "$1" bluetooth 2>/dev/null || rfkill "$1" bluetooth
}

controllers() {
  timeout 2s bluetoothctl list 2>/dev/null | awk '{print $2}'
}

# Any controller counts: the block is all-or-nothing across the radios.
powered() {
  local controller

  for controller in $(controllers); do
    [[ $(timeout 2s bluetoothctl show "$controller" 2>/dev/null) == *"Powered: yes"* ]] && return 0
  done

  return 1
}

# One deadline around the whole wait rather than a fixed number of probes:
# every probe can sit on its own timeout when D-Bus is wedged.
wait_powered() {
  local deadline=$((SECONDS + POWER_WAIT_SECONDS))

  while :; do
    powered && return 0
    ((SECONDS < deadline)) || return 1
    sleep 0.2
  done
}

power_on() {
  set_block unblock

  # Usually all it takes. bluetoothd will not power up an adapter that was
  # powered down without a block, so ask directly before giving up.
  wait_powered && return 0

  timeout 5s bluetoothctl power on >/dev/null 2>&1
  wait_powered && return 0

  echo "bluetooth-panel-power: adapter did not come up" >&2
  return 1
}

case "${1:-}" in
  on)
    power_on
    ;;
  off)
    # The block already drops the adapter to Powered: no, and it is the half
    # that survives the reboot.
    set_block block
    ;;
  toggle)
    if powered; then
      set_block block
    else
      power_on
    fi
    ;;
  is-on)
    powered
    ;;
  *)
    echo "Usage: bluetooth-panel-power <on|off|toggle|is-on>" >&2
    exit 1
    ;;
esac
