{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "System Dashboard",
  "version": "0.1.0",
  "identifier": "ai.sway.system-dashboard",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "System",
        "label": "main",
        "width": 420,
        "height": 700,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
