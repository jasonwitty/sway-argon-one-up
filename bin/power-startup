#!/bin/bash
# Set brightness and CPU governor based on AC/battery state at startup.
# Called once from sway config on login.

# Ask argon-battery-rs for the power state rather than reading the CW2217
# directly (same reasoning as bin/lid-suspend): when the gauge is asleep or its
# profile flag is clear every register reads garbage, and a raw read of 0x0E
# then returns 0xff -- bit 7 set, indistinguishable from "discharging". That
# pinned the machine to powersave and 40% brightness while on AC. argon-battery-rs
# knows the gauge's health and reports "unknown" instead.
battery_class=$(/usr/local/bin/argon-battery-rs 2>/dev/null |
    grep -o '"class": *"[^"]*"' | cut -d'"' -f4)

case "$battery_class" in
    charging)                        on_ac=1 ;;
    good|moderate|warning|critical)  on_ac=0 ;;
    *)
        # Gauge unreadable. Leave brightness alone, run the normal governor,
        # and still prime the state file as "on AC": argon-battery-rs skips
        # its AC/battery transition handling until that file exists, and once
        # the gauge recovers it corrects a wrong guess within a few polls.
        ~/.local/bin/power-mode ondemand
        echo "1" > /tmp/.argon-battery-charging
        exit 0
        ;;
esac

if [ "$on_ac" = 1 ]; then
    brightness=100
    governor="ondemand"
else
    brightness=40
    governor="powersave"
fi

# Set brightness via DDC/CI over I2C bus 14
python3 -c "
import os, fcntl
addr, val = 0x37, $brightness
s, l, op, vcp, vh, vl = 0x51, 0x84, 0x03, 0x10, 0x00, val
chk = (addr << 1) ^ s ^ l ^ op ^ vcp ^ vh ^ vl
fd = os.open('/dev/i2c-14', os.O_RDWR)
fcntl.ioctl(fd, 0x0703, addr)
os.write(fd, bytes([s, l, op, vcp, vh, vl, chk]))
os.close(fd)
" 2>/dev/null

echo "$brightness" > /tmp/.brightness_level

# Set CPU governor
~/.local/bin/power-mode "$governor"

# Prime the state file so argon-battery-rs doesn't re-trigger
echo "$on_ac" > /tmp/.argon-battery-charging
