# trackpad-guard replaces the AMIRA touchpad in libinput's view with a
# virtual uinput device so we can drop events during typing without
# triggering libinput's "touch-in-progress was cancelled" state machine.
#
# Two things this rule needs to enable:
#  1. Tell libinput to ignore the real AMIRA touchpad evdev node. The
#     daemon opens and grabs it directly.
#  2. Let the `input` group read+write /dev/uinput so the daemon (running
#     as the user) can create the virtual replacement device.

# Tag the AMIRA touchpad evdev nodes so libinput skips them. The AMIRA's
# mouse-class interface is exposed under two different evdev names
# depending on which kernel HID driver is bound (hid-generic shows it as
# "Mouse"; hid-multitouch shows it as "Touchpad"). We need to catch both
# so libinput can't sneak in via whichever variant happens to be present.
SUBSYSTEM=="input", ATTRS{name}=="AMIRA-KEYBOAR USB KEYBOARD Mouse", ENV{LIBINPUT_IGNORE_DEVICE}="1"
SUBSYSTEM=="input", ATTRS{name}=="AMIRA-KEYBOAR USB KEYBOARD Touchpad", ENV{LIBINPUT_IGNORE_DEVICE}="1"

# Grant the input group read+write access to /dev/uinput so the daemon
# can create the virtual replacement device without needing root.
KERNEL=="uinput", GROUP="input", MODE="0660"
