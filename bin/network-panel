#!/bin/bash
# network-panel — control the Quickshell network panel.
#
#   network-panel toggle   open/close the panel (waybar click, $mod+Ctrl+n)
#   network-panel open|close|toggleWifi|showQr|openCaptivePortal
#
# The panel runs inside the shared panels daemon; see `panels`.

case "${1:-toggle}" in
    open|close|toggle|toggleWifi|showQr|openCaptivePortal)
        exec "$HOME/.local/bin/panels" call network "${1:-toggle}"
        ;;
    *)
        echo "Usage: network-panel [toggle|open|close|toggleWifi|showQr|openCaptivePortal]" >&2
        exit 2
        ;;
esac
