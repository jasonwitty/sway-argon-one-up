#!/bin/bash
# bluetooth-panel — control the Quickshell Bluetooth panel.
#
#   bluetooth-panel toggle            open/close the panel (waybar click, $mod+Ctrl+b)
#   bluetooth-panel open|close
#   bluetooth-panel toggleBluetooth   turn the radio on/off (waybar right-click)
#   bluetooth-panel agent             run the pairing agent (exec'd by Sway at login)
#
# The panel runs inside the shared panels daemon; see `panels`.

case "${1:-toggle}" in
    open|close|toggle|toggleBluetooth)
        exec "$HOME/.local/bin/panels" call bluetooth "${1:-toggle}"
        ;;
    agent)
        # Pairing needs an agent registered with BlueZ, which blueman-applet
        # used to provide. NoInputNoOutput accepts "just works" pairing, the
        # same choice Omarchy makes; the adapter is not discoverable, so only
        # a device you pick in the panel gets as far as asking.
        #
        # Started from the Sway config, not a systemd user unit: nothing in
        # this session activates graphical-session.target, so a unit wanted by
        # it would never run.
        command -v bt-agent >/dev/null || { echo "bluetooth-panel: bt-agent not found (apt install bluez-tools)" >&2; exit 1; }
        pgrep -u "$USER" -x bt-agent >/dev/null && exit 0
        setsid -f bt-agent -c NoInputNoOutput >/dev/null 2>&1
        ;;
    *)
        echo "Usage: bluetooth-panel [toggle|open|close|toggleBluetooth|agent]" >&2
        exit 2
        ;;
esac
