#!/bin/bash
# Called by argon daemon on lid close/open
# Usage: lid-suspend close | lid-suspend open
XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XDG_RUNTIME_DIR
SWAYSOCK="$XDG_RUNTIME_DIR/sway-ipc.$(id -u).$(pgrep -x sway).sock"
export SWAYSOCK
export WAYLAND_DISPLAY=wayland-1

LOG="$HOME/.local/state/lid-events.log"
mkdir -p "$(dirname "$LOG")"

# Find webcam USB device path by vendor:product ID
find_webcam() {
    for dev in /sys/bus/usb/devices/*/idVendor; do
        devdir="$(dirname "$dev")"
        if [ "$(cat "$devdir/idVendor" 2>/dev/null)" = "11cc" ] &&
           [ "$(cat "$devdir/idProduct" 2>/dev/null)" = "2812" ]; then
            basename "$devdir"
            return
        fi
    done
}

log() { echo "  $1" >> "$LOG"; }

case "$1" in
    close)
        echo "=== LID CLOSE $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$LOG"

        swaylock -f &
        sleep 0.5
        swaymsg "output * power off"
        log "display: off"

        echo powersave | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null
        log "cpu governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"

        sudo rfkill block wifi
        sudo rfkill block bluetooth
        log "wifi: $(rfkill list wifi | grep -o 'Soft blocked: .*')"
        log "bluetooth: $(rfkill list bluetooth | grep -o 'Soft blocked: .*')"

        WEBCAM=$(find_webcam)
        if [ -n "$WEBCAM" ]; then
            echo "$WEBCAM" | sudo tee /sys/bus/usb/drivers/usb/unbind > /dev/null 2>&1
            log "webcam ($WEBCAM): unbound"
        else
            log "webcam: not found (already unbound or disconnected)"
        fi
        ;;
    open)
        echo "=== LID OPEN $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$LOG"

        swaymsg "output * power on"
        log "display: on"

        # Pick governor based on AC state so we don't clobber what
        # argon-battery-rs would set. Defaults to ondemand when the power state
        # can't be determined -- never pin the CPU to powersave on a bad read.
        #
        # Ask argon-battery-rs rather than reading the CW2217 directly: it knows
        # when the IC is asleep or its profile flag is clear (in which case
        # every register reads garbage) and reports "unknown" instead of a
        # plausible-looking lie. A raw `i2cget 0x0e` returns 0xff on a failed
        # read, and 0xff has bit 7 set -- indistinguishable from "discharging".
        # That is exactly what happened on 2026-08-05: a resume on AC pinned the
        # machine to powersave because the gauge was returning 0xff.
        governor="ondemand"
        battery_class=$(/usr/local/bin/argon-battery-rs 2>/dev/null |
            grep -o '"class": *"[^"]*"' | cut -d'"' -f4)
        case "$battery_class" in
            charging)                        governor="ondemand" ;;
            good|moderate|warning|critical)  governor="powersave" ;;
            *)
                # argon-battery-rs missing or unparseable -- fall back to the
                # raw register, still treating an all-ones read as unknown.
                current_high=$(i2cget -y 1 0x64 0x0e 2>/dev/null)
                if [ -n "$current_high" ] && [ "$current_high" != "0xff" ] &&
                   (( (current_high & 0x80) != 0 )); then
                    governor="powersave"
                fi
                ;;
        esac
        echo "$governor" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null
        log "cpu governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor) (battery_class=${battery_class:-?} ac_reg=${current_high:-n/a})"

        sudo rfkill unblock wifi
        sudo rfkill unblock bluetooth
        log "wifi: $(rfkill list wifi | grep -o 'Soft blocked: .*')"
        log "bluetooth: $(rfkill list bluetooth | grep -o 'Soft blocked: .*')"

        # Rebind webcam — after unbind the sysfs entry still exists, so we can find it
        WEBCAM=$(find_webcam)
        if [ -z "$WEBCAM" ]; then
            # Fallback: scan for unbound device by ID in sysfs
            for dev in /sys/bus/usb/devices/*/idVendor; do
                devdir="$(dirname "$dev")"
                if [ "$(cat "$devdir/idVendor" 2>/dev/null)" = "11cc" ] &&
                   [ "$(cat "$devdir/idProduct" 2>/dev/null)" = "2812" ]; then
                    WEBCAM=$(basename "$devdir")
                    break
                fi
            done
        fi
        if [ -n "$WEBCAM" ]; then
            echo "$WEBCAM" | sudo tee /sys/bus/usb/drivers/usb/bind > /dev/null 2>&1
            log "webcam ($WEBCAM): bound"
        else
            log "webcam: not found"
        fi
        ;;
esac
