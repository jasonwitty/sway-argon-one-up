{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "custom/clock"
  ],
  "modules-right": [
    "custom/recording",
    "custom/claude",
    "custom/help",
    "custom/theme",
    "custom/idle",
    "custom/scale",
    "cpu",
    "custom/argon-fan",
    "pulseaudio",
    "backlight",
    "custom/argon-battery",
    "network",
    "bluetooth",
    "tray",
    "custom/power"
  ],
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 5,
    "tooltip": true,
    "on-click": "foot -e socktop --demo"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰂲 muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰂑",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip": true,
    "tooltip-format": "{desc} — {volume}%\nRight-click: choose output",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "audio-sink-picker"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "tooltip-format-disconnected": "Offline",
    "tooltip": true,
    "on-click": "~/.local/bin/network-panel toggle",
    "on-click-right": "foot -e nmtui"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-no-controller": "",
    "tooltip-format": "Bluetooth on",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-off": "Bluetooth off",
    "tooltip-format-disabled": "Bluetooth off",
    "on-click": "~/.local/bin/bluetooth-panel toggle",
    "on-click-right": "~/.local/bin/bluetooth-panel toggleBluetooth"
  },
  "backlight": {
    "format": "󰃠 {percent}%",
    "tooltip": false
  },
  "custom/claude": {
    "format": "󰗚 ",
    "tooltip": false,
    "on-click": "foot -e ~/.local/bin/claude",
    "on-click-right": "~/.local/bin/claude-prompt"
  },
  "custom/help": {
    "format": "󰋖 ",
    "tooltip": false,
    "on-click": "~/.local/bin/sway-help"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/argon-battery": {
    "exec": "/usr/local/bin/argon-battery-rs",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "~/.local/bin/power-mode toggle"
  },
  "custom/argon-fan": {
    "exec": "/usr/local/bin/argon-fan waybar",
    "return-type": "json",
    "interval": 3,
    "tooltip": true,
    "on-click": "/usr/local/bin/argon-fan picker",
    "on-click-right": "/usr/local/bin/argon-fan edit-config"
  },
  "custom/theme": {
    "exec": "~/.local/bin/switch-theme --waybar-status",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "swaymsg exec ~/.local/bin/switch-theme\\ --picker"
  },
  "custom/scale": {
    "exec": "~/.local/bin/sway-scale get",
    "interval": 2,
    "format": "󰍉 {}",
    "tooltip": false,
    "on-click": "swaymsg exec ~/.local/bin/sway-scale\\ picker"
  },
  "custom/idle": {
    "exec": "~/.local/bin/idle-toggle status",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "~/.local/bin/idle-toggle cycle"
  },
  "custom/recording": {
    "exec": "~/.local/bin/screen-record status",
    "return-type": "json",
    "interval": 1,
    "tooltip": true
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.local/bin/power-prompt"
  },
  "custom/clock": {
    "exec": "~/.local/bin/clock-label",
    "tooltip": false,
    "on-click": "~/.local/bin/clock-panel toggle",
    "on-click-right": "~/.local/bin/clock-label cycle"
  }
}
